.DS_Store
.claude/settings.local.json

# Stray rendered previews (RStudio/markdown-viewer auto-render of a .md
# file into HTML), never a real repo artifact
*.html
*_files/

# Personal cross-repo reference doc, not repo documentation
MODEL_BRIDGE.md

# FantasyPros ECR feed drops: licensed data, never redistribute via the repo
data/ecr/
data/vegas/

# Raw vendor exports (PFF, Reception Perception, etc): keep out of git
# regardless of ToS status on any given vendor -- never redistribute.
data/vendor_raw/
logs/cron.log
output/latest/
scripts/earnest_delivery.env

# Movers columns are drafted to ~/content/draft, not this repo. Guard against
# a stray landing in content/ (the committed 2025_w15 demo stays tracked).
content/*_movers_column.md

# Agent worktrees (session scratch, never project content)
.claude/worktrees/
logs/*.log

# PFF-named scripts/data/output: name-transparency rule -- never commit a
# file whose path itself reveals PFF as a source, even though PFF-derived
# feature/column names inside other committed files are fine.
pff_experimentation/
